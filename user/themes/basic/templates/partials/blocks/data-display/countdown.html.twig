{% set countdown_number = countdown_value|default(0)|number_format(0, '.', '') %}
<span class="countdown font-mono text-5xl"{% if countdown_seconds is defined %} data-countdown-seconds="{{ countdown_seconds|default(countdown_value)|e('html_attr') }}"{% endif %} aria-label="{{ countdown_label|default(countdown_number)|e('html_attr') }}">
    <span style="--value: {{ countdown_number|e('html_attr') }};">{{ countdown_number|e }}</span>
</span>
