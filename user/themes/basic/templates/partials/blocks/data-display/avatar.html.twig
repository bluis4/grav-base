{% if avatar_image %}
    <div class="avatar">
        <div class="w-12 rounded-full"><img src="{{ avatar_image|e('html_attr') }}" alt="{{ avatar_alt|default('')|e('html_attr') }}" /></div>
    </div>
{% else %}
    <div class="avatar avatar-placeholder">
        <div class="w-12 rounded-full bg-neutral text-neutral-content"><span>{{ avatar_fallback|default('?')|e }}</span></div>
    </div>
{% endif %}
