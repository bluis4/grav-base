{% set image_value = card.image|default('') %}
{% set site_image_name = image_value starts with 'media://' ? image_value|replace({'media://': ''}) : image_value %}
{% set image = image_value starts with 'media://' ? (site_media ? site_media[site_image_name] : null) : module.media[image_value] %}
{% set image_url = image ? image.url : (image_value starts with 'media://' ? url(image_value) : '') %}
<article class="card card-border bg-base-100 shadow-sm">
    {% if image or image_url %}
        <figure class="aspect-[4/3] overflow-hidden">
            {% if image %}
                {% include 'partials/modern_image.html.twig' with {
                    image: image,
                    image_class: 'h-full w-full object-cover',
                    image_alt: card.alt|default(''),
                    image_loading: 'lazy'
                } only %}
            {% else %}
                <img class="h-full w-full object-cover" src="{{ image_url|e('html_attr') }}" alt="{{ card.alt|default('')|e('html_attr') }}" loading="lazy" />
            {% endif %}
        </figure>
    {% endif %}
    <div class="card-body">
        <h3 class="card-title">{{ card.title|e }}</h3>
        <p>{{ card.description|e }}</p>
        {% if card.button_url and card.button_label %}
            <div class="card-actions mt-4">
                {% include 'partials/blocks/actions/button.html.twig' with {
                    button_url: card.button_url,
                    button_label: card.button_label,
                    button_class: 'btn-outline btn-primary'
                } only %}
            </div>
        {% endif %}
    </div>
</article>
