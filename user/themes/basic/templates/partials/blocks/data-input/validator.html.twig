<label class="fieldset"><span class="fieldset-legend">{{ validator_label|default('Email address')|e }}</span><input class="input validator" type="{{ validator_type|default('email')|e('html_attr') }}" name="{{ validator_name|default('email')|e('html_attr') }}" placeholder="{{ validator_placeholder|default('mail@example.com')|e('html_attr') }}"{% if validator_required|default(true) %} required{% endif %}>{% if validator_hint|default('') %}<span class="validator-hint">{{ validator_hint|e }}</span>{% endif %}</label>
