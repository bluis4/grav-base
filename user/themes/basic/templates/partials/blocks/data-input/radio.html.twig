<label class="label cursor-pointer justify-start gap-3"><input class="radio {{ radio_class|default('radio-primary')|e('html_attr') }}" type="radio" name="{{ radio_name|default('choice')|e('html_attr') }}" value="{{ radio_value|default('option')|e('html_attr') }}"{% if radio_checked|default(false) %} checked{% endif %}><span class="label-text">{{ radio_label|default('Option')|e }}</span></label>
