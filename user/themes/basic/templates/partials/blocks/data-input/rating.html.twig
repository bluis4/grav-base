<div class="rating" role="radiogroup" aria-label="{{ rating_label|default('Rating')|e('html_attr') }}">
    {% for value in 1..(rating_max|default(5)) %}<input class="mask mask-star-2 bg-orange-400" type="radio" name="{{ rating_name|default('rating')|e('html_attr') }}" value="{{ value }}" aria-label="{{ value }} star{% if value != 1 %}s{% endif %}"{% if value == rating_value|default(0) %} checked{% endif %}>{% endfor %}
</div>
