<fieldset class="fieldset"><legend class="fieldset-legend">{{ otp_label|default('Enter verification code')|e }}</legend><div class="join">{% for digit in 1..(otp_length|default(6)) %}<input class="input join-item w-12 text-center" type="text" inputmode="numeric" autocomplete="one-time-code" maxlength="1" name="{{ (otp_name|default('otp') ~ '_' ~ digit)|e('html_attr') }}" aria-label="{{ ('Digit ' ~ digit)|e('html_attr') }}">{% endfor %}</div></fieldset>
