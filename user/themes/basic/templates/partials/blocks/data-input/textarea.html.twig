<label class="fieldset"><span class="fieldset-legend">{{ textarea_label|default('Your message')|e }}</span><textarea class="textarea {{ textarea_class|default('textarea-bordered')|e('html_attr') }}" name="{{ textarea_name|default('message')|e('html_attr') }}" placeholder="{{ textarea_placeholder|default('')|e('html_attr') }}"{% if textarea_required|default(false) %} required{% endif %}>{{ textarea_value|default('')|e }}</textarea></label>
