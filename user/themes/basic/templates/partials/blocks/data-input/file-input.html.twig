<label class="fieldset"><span class="fieldset-legend">{{ file_input_label|default('Choose a file')|e }}</span><input class="file-input {{ file_input_class|default('file-input-bordered')|e('html_attr') }}" type="file" name="{{ file_input_name|default('file')|e('html_attr') }}"{% if file_input_accept|default('') %} accept="{{ file_input_accept|e('html_attr') }}"{% endif %}>{% if file_input_hint|default('') %}<span class="fieldset-label">{{ file_input_hint|e }}</span>{% endif %}</label>
