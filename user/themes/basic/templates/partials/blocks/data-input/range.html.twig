<label class="fieldset"><span class="fieldset-legend">{{ range_label|default('Volume')|e }}</span><input class="range {{ range_class|default('range-primary')|e('html_attr') }}" type="range" min="{{ range_min|default(0) }}" max="{{ range_max|default(100) }}" value="{{ range_value|default(50) }}"{% if range_step|default(0) %} step="{{ range_step }}"{% endif %}><span class="fieldset-label">{{ range_min|default(0) }} <span class="float-right">{{ range_max|default(100) }}</span></span></label>
