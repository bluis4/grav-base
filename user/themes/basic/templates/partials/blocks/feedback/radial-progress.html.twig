<div class="radial-progress {{ radial_progress_class|default('text-primary')|e('html_attr') }}" role="progressbar" style="--value:{{ radial_progress_value|default(70) }}; --size:{{ radial_progress_size|default('5rem')|e('html_attr') }}; --thickness:{{ radial_progress_thickness|default('0.5rem')|e('html_attr') }};" aria-valuenow="{{ radial_progress_value|default(70) }}" aria-valuemin="0" aria-valuemax="100">{{ radial_progress_value|default(70) }}%</div>
