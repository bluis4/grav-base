{% set component = block.component|default('data-display/badge') %}
{% set component_values = block[component]|default({}) %}
{% if component_values is iterable %}{% set block = block|merge(component_values) %}{% endif %}
{% set raw_image = block.image|default('') %}
{% set image_name = raw_image starts with 'media://' ? raw_image|replace({'media://': ''}) : raw_image %}
{% set block_image = null %}
{% if raw_image %}
    {% set block_image = raw_image starts with 'media://' ? (hero_site_media ? hero_site_media[image_name] : null) : hero_page_media[raw_image] %}
{% endif %}
{% set image_url = block_image ? block_image.url : (raw_image starts with 'media://' ? url(raw_image) : '') %}
{% set component_items = [] %}
{% for item in block.items|default([]) %}
    {% set item_image_value = item.image|default('') %}
    {% set item_image_name = item_image_value starts with 'media://' ? item_image_value|replace({'media://': ''}) : item_image_value %}
    {% set item_image = item_image_value ? (item_image_value starts with 'media://' ? (hero_site_media ? hero_site_media[item_image_name] : null) : hero_page_media[item_image_value]) : null %}
    {% set component_items = component_items|merge([{
        label: item.label|default(item.title|default('Item')),
        title: item.title|default(item.label|default('Item')),
        content: item.text|default(''),
        text: item.text|default(''),
        value: item.value|default(''),
        url: item.url|default('#'),
        image: item_image ? item_image.url : (item_image_value starts with 'media://' ? url(item_image_value) : item_image_value),
        alt: item.alt|default(''),
        time: item.value|default(''),
        active: loop.first
    }]) %}
{% endfor %}
{% set dropdown_items = [] %}
{% for item in block.items|default([]) %}
    {% set item_link_source = item.link_source|default('custom') %}
    {% set item_link_type = item_link_source is iterable ? item_link_source.type|default('') : item_link_source %}
    {% set item_page_values = item.page|default({}) %}
    {% set item_custom_values = item.custom|default({}) %}
    {% set item_source_page = item_link_source is iterable ? item_link_source.page|default({}) : {} %}
    {% set item_source_custom = item_link_source is iterable ? item_link_source.custom|default({}) : {} %}
    {% set item_source_flat_page = item_link_source is iterable ? item_link_source.link_page|default('') : '' %}
    {% set item_source_flat_custom = item_link_source is iterable ? item_link_source.link_custom_url|default('') : '' %}
    {% set item_page_route = item_page_values.link_page|default(item_source_page.link_page|default(item_source_flat_page|default(item.link_page|default('')))) %}
    {% if item_page_route is iterable %}{% set item_page_route = item_page_route|first|default('') %}{% endif %}
    {% set item_custom_url = item_custom_values.link_custom_url|default(item_source_custom.link_custom_url|default(item_source_flat_custom|default(item.link_custom_url|default('')))) %}
    {% set item_url = item_custom_url|default(item.link_destination|default(item.url|default('#'))) %}
    {% if item_link_type == 'page' and item_page_route %}
        {% set linked_item_page = grav['pages'].find(item_page_route) %}
        {% set item_url = linked_item_page ? linked_item_page.url : item_page_route %}
    {% endif %}
    {% set dropdown_items = dropdown_items|merge([{
        label: item.item_text|default(item.label|default(item.title|default('Menu item'))),
        url: item_url,
        url_behavior: item.url_behavior|default('same')
    }]) %}
{% endfor %}

{# Every other component renders from its own partial under components/<category>/<name>. #}
{% set speed_dial_settings = block.speed_dial_settings|default({}) %}
{% set fab_link_settings = block.fab_link_settings|default({}) %}
{% set fab_link_source = fab_link_settings.fab_link_source|default(block.fab_link_source|default('custom')) %}
{% set fab_link_type = fab_link_source is iterable ? fab_link_source.type|default('') : fab_link_source %}
{% set fab_page_values = fab_link_source is iterable ? fab_link_source.page|default({}) : {} %}
{% set fab_page_values = fab_link_settings.page|default(block.page|default(fab_page_values)) %}
{% set fab_custom_values = fab_link_source is iterable ? fab_link_source.custom|default({}) : {} %}
{% set fab_custom_values = fab_link_settings.custom|default(block.custom|default(fab_custom_values)) %}
{% set fab_link_page = fab_page_values.fab_page|default(fab_link_source.fab_page|default(block.fab_page|default(''))) %}
{% if fab_link_page is iterable %}{% set fab_link_page = fab_link_page|first|default('') %}{% endif %}
{% set fab_custom_url = fab_custom_values.fab_custom_url|default(fab_link_source.fab_custom_url|default(block.fab_custom_url|default(''))) %}
{% set fab_url = fab_custom_url %}
{% if fab_link_type == 'page' and fab_link_page %}
    {% set fab_linked_page = grav['pages'].find(fab_link_page) %}
    {% set fab_url = fab_linked_page ? fab_linked_page.url : fab_link_page %}
{% endif %}
{% set fab_url_behavior = fab_link_settings.fab_url_behavior|default(block.fab_url_behavior|default('same')) %}
{% if fab_url_behavior not in ['same', 'new_tab', 'new_window'] %}{% set fab_url_behavior = 'same' %}{% endif %}
{% set fab_items = [] %}
{% for item in speed_dial_settings.items|default(block.items|default([])) %}
    {% set item_link_source = item.item_link_source|default('custom') %}
    {% set item_link_type = item_link_source is iterable ? item_link_source.type|default('') : item_link_source %}
    {% set item_page_values = item.page|default({}) %}
    {% set item_custom_values = item.custom|default({}) %}
    {% set item_source_page = item_link_source is iterable ? item_link_source.page|default({}) : {} %}
    {% set item_source_custom = item_link_source is iterable ? item_link_source.custom|default({}) : {} %}
    {% set item_page_route = item_page_values.item_page|default(item_source_page.item_page|default(item.item_page|default(''))) %}
    {% if item_page_route is iterable %}{% set item_page_route = item_page_route|first|default('') %}{% endif %}
    {% set item_custom_url = item_custom_values.item_custom_url|default(item_source_custom.item_custom_url|default(item.item_custom_url|default(''))) %}
    {% set item_url = item_custom_url|default('#') %}
    {% if item_link_type == 'page' and item_page_route %}
        {% set linked_item_page = grav['pages'].find(item_page_route) %}
        {% set item_url = linked_item_page ? linked_item_page.url : item_page_route %}
    {% endif %}
    {% set fab_items = fab_items|merge([{
        label: item.item_label|default(''),
        type: item.item_type|default('text'),
        text: item.item_text_fields.item_text|default(item.item_text|default('')),
        icon: item.item_icon_fields.item_icon|default(item.item_icon|default('')),
        url: item_url,
        url_behavior: item.item_url_behavior|default('same')
    }]) %}
{% endfor %}

{% set items = component_items %}
{% set dropdown_position = block.dropdown_position|default('start') %}
{% if dropdown_position not in ['start', 'center', 'end'] %}{% set dropdown_position = 'start' %}{% endif %}
{% set dropdown_direction = block.dropdown_direction|default('bottom') %}
{% if dropdown_direction not in ['top', 'bottom', 'left', 'right'] %}{% set dropdown_direction = 'bottom' %}{% endif %}
{% set link_source = block.button_link_source|default('custom') %}
{% set link_type = link_source is iterable ? link_source.type|default('') : link_source %}
{% set page_values = block.page|default({}) %}
{% set custom_values = block.custom|default({}) %}
{% set source_page = link_source is iterable ? link_source.page|default({}) : {} %}
{% set source_custom = link_source is iterable ? link_source.custom|default({}) : {} %}
{% set source_flat_page = link_source is iterable ? link_source.button_page|default('') : '' %}
{% set source_flat_custom = link_source is iterable ? link_source.button_custom_url|default('') : '' %}
{% set link_page = page_values.button_page|default(source_page.button_page|default(source_flat_page|default(block.button_page|default('')))) %}
{% if link_page is iterable %}{% set link_page = link_page|first|default('') %}{% endif %}
{% set link_url = custom_values.button_custom_url|default(source_custom.button_custom_url|default(source_flat_custom|default(block.button_custom_url|default(block.button_url|default(block.url|default('#')))))) %}
{% if link_type == 'page' and link_page %}
    {% set linked_page = grav['pages'].find(link_page) %}
    {% set link_url = linked_page ? linked_page.url : link_page %}
{% endif %}
