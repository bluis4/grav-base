{% set modal_id = modal_id|default('basic-modal-' ~ random()) %}
{% set modal_close = modal_close_label|default(modal_close|default('Close')) %}
{% set modal_button_classes = ('btn ' ~ modal_button_class|default(''))|trim %}
<button type="button" class="{{ modal_button_classes|e('html_attr') }}" onclick="document.getElementById('{{ modal_id|e('js') }}').showModal()">{{ modal_trigger|default('Open dialog')|e }}</button>
<dialog id="{{ modal_id|e('html_attr') }}" class="modal" aria-labelledby="{{ modal_id|e('html_attr') }}-title">
    <div class="modal-box">
        <h2 id="{{ modal_id|e('html_attr') }}-title" class="text-lg font-bold">{{ modal_title|default('Dialog')|e }}</h2>
        {% if modal_content %}<p class="py-4">{{ modal_content|e }}</p>{% endif %}
        <div class="modal-action"><form method="dialog"><button class="btn">{{ modal_close|e }}</button></form></div>
    </div>
    <form method="dialog" class="modal-backdrop"><button>{{ modal_close|e }}</button></form>
</dialog>
