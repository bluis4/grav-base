<label class="label cursor-pointer justify-start gap-3"><input class="checkbox {{ checkbox_class|default('checkbox-primary')|e('html_attr') }}" type="checkbox" name="{{ checkbox_name|default('option')|e('html_attr') }}" value="{{ checkbox_value|default('1')|e('html_attr') }}"{% if checkbox_checked|default(false) %} checked{% endif %}><span class="label-text">{{ checkbox_label|default('Accept the option')|e }}</span></label>
