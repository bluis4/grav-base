<div class="calendar w-fit rounded-box border border-base-300 bg-base-100 p-3" role="group" aria-label="{{ calendar_label|default('Calendar')|e('html_attr') }}">
    <div class="mb-3 text-center font-semibold">{{ calendar_month|default('Choose a date')|e }}</div>
    <div class="grid grid-cols-7 gap-1 text-center text-sm">{% for day in calendar_days|default([]) %}<button class="btn btn-ghost btn-sm" type="button"{% if day.selected|default(false) %} aria-pressed="true"{% endif %}>{{ day.label|default('1')|e }}</button>{% endfor %}</div>
</div>
