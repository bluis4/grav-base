<label class="fieldset"><span class="fieldset-legend">{{ select_label|default('Choose an option')|e }}</span><select class="select {{ select_class|default('select-bordered')|e('html_attr') }}" name="{{ select_name|default('option')|e('html_attr') }}">{% for item in select_options|default([]) %}<option value="{{ item.value|default('')|e('html_attr') }}"{% if item.selected|default(false) %} selected{% endif %}>{{ item.label|default('Option')|e }}</option>{% endfor %}</select></label>
