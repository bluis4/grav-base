<div class="relative isolate overflow-hidden bg-primary px-4 py-12 text-primary-content md:py-16">
    <div class="pointer-events-none absolute -right-16 -top-24 h-72 w-72 rounded-full border border-white/15"></div>
    <div class="pointer-events-none absolute -right-2 -top-10 h-44 w-44 rounded-full border border-white/15"></div>
    <div class="relative mx-auto grid w-full max-w-6xl grid-cols-1 gap-8 md:grid-cols-[minmax(0,1fr)_auto] md:items-center">
        <div class="max-w-2xl">
            <p class="mb-3 text-xs font-bold uppercase tracking-[0.2em] text-primary-content/70">One good next step</p>
            <h2 class="text-3xl font-bold tracking-tight md:text-4xl">{{ module.header.heading|default(module.title)|e }}</h2>
            {% if module.header.description %}<p class="mt-3 max-w-2xl text-primary-content/80">{{ module.header.description|e }}</p>{% endif %}
        </div>
        <div class="md:justify-self-end">
            {% include 'partials/components/actions/button.html.twig' with {
                button_url: module.header.button_url|default(''),
                button_label: module.header.button_label|default(''),
                button_class: 'btn-secondary'
            } only %}
        </div>
    </div>
</div>
