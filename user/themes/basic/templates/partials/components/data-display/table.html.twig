<div class="overflow-x-auto">
    <table class="table table-zebra">
        {% if table_columns|default([]) %}<thead><tr>{% for column in table_columns %}<th>{{ column|e }}</th>{% endfor %}</tr></thead>{% endif %}
        <tbody>
            {% for row in table_rows|default([]) %}
                <tr>{% for cell in row %}<td>{{ cell|e }}</td>{% endfor %}</tr>
            {% endfor %}
        </tbody>
    </table>
</div>
