<div class="components-library mx-auto grid w-full max-w-7xl gap-8 px-4 py-12 sm:grid-cols-[14rem_minmax(0,1fr)] sm:gap-10">
    <aside class="components-library__sidebar sm:sticky sm:top-6 sm:max-h-[calc(100vh-3rem)] sm:overflow-y-auto" aria-label="Component categories">
        <p class="mb-3 text-xs font-bold uppercase tracking-widest text-base-content/60">Components</p>
        <nav>
            <ul class="menu menu-sm rounded-box bg-base-200 p-2">
                {% for category in categories %}
                    <li>
                        <a class="font-bold" href="#{{ category.id|e('html_attr') }}">{{ category.title|e }}</a>
                        <ul>
                            {% for component in category.items %}
                                <li><a href="#{{ (category.id ~ '-' ~ component.id)|e('html_attr') }}">{{ component.title|e }}</a></li>
                            {% endfor %}
                        </ul>
                    </li>
                {% endfor %}
            </ul>
        </nav>
    </aside>

    <div class="min-w-0">
        <header class="mb-12 border-b border-base-300 pb-8">
            <p class="mb-4 inline-flex items-center gap-3 text-xs font-bold uppercase tracking-[0.24em] text-primary"><span class="h-px w-8 bg-secondary"></span>Basic theme library</p>
            <h1 class="text-4xl font-bold leading-tight tracking-tight md:text-6xl">Components</h1>
            <p class="mt-5 max-w-3xl text-lg leading-relaxed text-base-content/70">Browse the reusable daisyUI components included with this theme. Choose an item from the navigation to jump to its example on this page.</p>
        </header>

        {% for category in categories %}
            <section id="{{ category.id|e('html_attr') }}" class="component-category mb-14 scroll-mt-24">
                <h2 class="mb-6 border-b border-base-300 pb-3 text-3xl font-bold">{{ category.title|e }}</h2>
                <div class="space-y-6">
                    {% for component in category.items %}
                        <article id="{{ (category.id ~ '-' ~ component.id)|e('html_attr') }}" class="component-example scroll-mt-24 rounded-box border border-base-300 bg-base-100 shadow-sm">
                            <h3 class="border-b border-base-300 px-5 py-3 text-xl font-semibold">{{ component.title|e }}</h3>
                            <div class="component-example__preview p-5 md:p-8">
                                {% include component.partial with component.vars only %}
                            </div>
                        </article>
                    {% endfor %}
                </div>
            </section>
        {% endfor %}
    </div>
</div>
